# 1351. Count Negative Numbers in a Sorted Matrix

from typing import List

class Solution:
    def countNegatives(self, grid: List[List[int]]) -> int:
        m, n = len(grid), len(grid[0])
        r, c = m-1, 0
        ans = 0

        while r >= 0 and c < n:
            if grid[r][c] < 0:
                ans += n-c
                r -= 1
            else:
                c += 1

        return ans
