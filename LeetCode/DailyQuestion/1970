# 1970. Last Day Where You Can Still Cross

from typing import List

class Solution:
    def latestDayToCross(self, row: int, col: int, cells: List[List[int]]) -> int:
        directions = [(1,0),(-1,0),(0,1),(0,-1)]

        def canCross(day):
            grid = [[0]*col for _ in range(row)]
            for i in range(day):
                r, c = cells[i]
                grid[r-1][c-1] = 1

            from collections import deque
            q = deque()

            for c in range(col):
                if grid[0][c] == 0:
                    q.append((0,c))
                    grid[0][c] = 1

            while q:
                r, c = q.popleft()
                if r == row-1:
                    return True
                for dr, dc in directions:
                    nr, nc = r+dr, c+dc
                    if 0 <= nr < row and 0 <= nc < col and grid[nr][nc] == 0:
                        grid[nr][nc] = 1
                        q.append((nr,nc))
            return False

        l, r = 0, len(cells)
        while l < r:
            m = (l+r+1)//2
            if canCross(m):
                l = m
            else:
                r = m-1
        return l
