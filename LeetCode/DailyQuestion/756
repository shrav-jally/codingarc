# 756. Pyramid Transition Matrix

from typing import List
from collections import defaultdict
from functools import lru_cache

class Solution:
    def pyramidTransition(self, bottom: str, allowed: List[str]) -> bool:
        mp = defaultdict(list)
        for s in allowed:
            mp[s[:2]].append(s[2])

        @lru_cache(None)
        def dfs(row):
            if len(row) == 1:
                return True

            def build(idx, cur):
                if idx == len(row)-1:
                    return dfs("".join(cur))

                pair = row[idx:idx+2]
                if pair not in mp:
                    return False

                for ch in mp[pair]:
                    cur.append(ch)
                    if build(idx+1, cur):
                        return True
                    cur.pop()
                return False

            return build(0, [])

        return dfs(bottom)
