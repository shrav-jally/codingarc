# 2110. Number of Smooth Descent Periods of a Stock
class Solution:
    def getDescentPeriods(self, prices: List[int]) -> int:
        ans = 1
        cur = 1
        for i in range(1, len(prices)):
            if prices[i - 1] - prices[i] == 1:
                cur += 1
            else:
                cur = 1
            ans += cur
        return ans
