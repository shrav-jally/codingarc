# 955. Delete Columns to Make Sorted II

from typing import List

class Solution:
    def minDeletionSize(self, strs: List[str]) -> int:
        n = len(strs)
        m = len(strs[0])

        sorted_pair = [False] * (n - 1)
        ans = 0

        for col in range(m):
            bad = False

            for i in range(n - 1):
                if not sorted_pair[i] and strs[i][col] > strs[i + 1][col]:
                    bad = True
                    break

            if bad:
                ans += 1
                continue

            for i in range(n - 1):
                if strs[i][col] < strs[i + 1][col]:
                    sorted_pair[i] = True

        return ans
