class Solution:
    def intervalIntersection(self, firstList: List[List[int]], secondList: List[List[int]]) -> List[List[int]]:
        final = []

        for i in range(len(firstList)):
            for p in range(len(secondList)):
                start = max(firstList[i][0], secondList[p][0])
                end = min(firstList[i][1], secondList[p][1])

                if start <= end:
                    final.append([start, end])

        return final
