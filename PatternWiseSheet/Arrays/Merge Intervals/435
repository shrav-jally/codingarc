class Solution:
    def eraseOverlapIntervals(self, intervals: List[List[int]]) -> int:
        count=0
        intervals.sort(key=lambda x: x[1])
        p=0
        while p<len(intervals)-1:
            if intervals[p][1]>intervals[p+1][0]:
                intervals.pop(p+1)
                count+=1
            else:
                p+=1
        return count

            
