class Solution:
    def removeDuplicates(self, nums: List[int]) -> int:
        s = set()
        for i in range(len(nums) - 1, -1, -1):
            if nums[i] in s:
                nums.append(nums.pop(i))
            else:
                s.add(nums[i])
        return len(s)


class Solution:
    def removeDuplicates(self, nums: List[int]) -> int:
        if not nums:
            return 0
        p = 1
        for i in range(1, len(nums)):
            if nums[i] != nums[p - 1]:
                nums[p] = nums[i]
                p += 1
        return p
